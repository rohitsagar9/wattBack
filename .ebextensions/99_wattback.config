option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: wattback_web.settings
    DEBUG: "0"
    ALLOWED_HOSTS: "*"
    SQLITE_PATH: /var/app/wattback_data/db.sqlite3
  aws:elasticbeanstalk:cloudwatch:logs:
    RetentionInDays: 7
container_commands:
  01_migrate:
    command: "mkdir -p /var/app/wattback_data && python manage.py migrate --noinput && chown -R webapp:webapp /var/app/wattback_data"
    leader_only: true
  02_load_wattback:
    command: "python manage.py load_wattback && chown -R webapp:webapp /var/app/wattback_data"
    leader_only: true
